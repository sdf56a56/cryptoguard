# CryptoGuard 配置示例 —— 复制为 backend/.env 后按需修改
#
#   规则:
#     1. 本文件只放**示例/空值**,真实密钥一律写入 .env(.env 已被 .gitignore 忽略);
#     2. 任何密钥都不得出现在前端代码、公开配置文件、Git 仓库或 Docker 镜像里;
#     3. 生产环境(CG_ENV=production)启动期强制校验:必须设 CG_ADMIN_TOKEN、
#        禁止 CG_ALLOW_ANONYMOUS=1、禁止示例密钥,否则拒绝启动(fail-closed)。

# --------------------------------------------------------------------------- #
# 信任根(与既有演示平台共用;一旦丢失,所有封缄日志与映射都不再可校验)
# --------------------------------------------------------------------------- #
# 64 位十六进制;用于派生各用途域子密钥(HKDF-SHA256)。生成方式:
#   python -c "import secrets;print(secrets.token_hex(32))"
VAULT_KEY=

# --------------------------------------------------------------------------- #
# 基础
# --------------------------------------------------------------------------- #
CG_ENV=development              # development | production
CG_HOST=127.0.0.1
CG_PORT=8100
CG_ADMIN_TOKEN=                 # 管理接口令牌(≥16 字符);空 = 管理接口返回 503
CG_ALLOW_ANONYMOUS=0            # 1 = 允许未认证调用(仅本机调试;生产禁止)

# --------------------------------------------------------------------------- #
# 上游提供商(JSON 数组)。密钥只写「环境变量名」,真实密钥放在下面各 provider 的
# *_API_KEY 里 —— 上游密钥与客户端密钥严格分离。
#
# 每项字段:
#   name/type/base_url/models/display_name  必填(除 base_url 对 mock 可空)
#   api_key_env     密钥所在的环境变量名(key_source=env 时使用)
#   key_source      env(默认,从环境变量读取)
#                 | llm-config(复用既有平台「LLM 配置」页保存的 AES-GCM 加密密钥;
#                   改钥后立即生效、无需重启,密钥仍不落明文)
#   token_limit_field  max_tokens(默认)或 max_completion_tokens(少数新模型只认后者)
#   extra_headers/stream_options  厂商附加要求(如 DeepSeek 流式必须 include_usage)
#   trust_env       是否让 httpx 采纳环境/系统代理(默认 false,见下方安全说明)
# --------------------------------------------------------------------------- #
CG_PROVIDERS=[{"name":"deepseek","type":"openai-compatible","base_url":"https://api.deepseek.com","api_key_env":"CG_PROVIDER_DEEPSEEK_KEY","models":["deepseek-chat"],"display_name":"DeepSeek","timeout_connect":10,"timeout_read":120,"max_retries":2,"trust_env":false}]
CG_PROVIDER_DEEPSEEK_KEY=        # 真实上游密钥(勿提交)
CG_DEFAULT_PROVIDER=deepseek
CG_DEFAULT_MODEL=deepseek-chat
# 把客户端使用的模型名映射到 provider/model(例如让 Claude Code 的模型名指向你的上游)
CG_MODEL_ALIASES={}
CG_ALLOW_UNKNOWN_MODELS=0        # 1 = 允许把未声明模型透传给默认提供商(有费用风险)
CG_UPSTREAM_TIMEOUT_CONNECT=10
CG_UPSTREAM_TIMEOUT_READ=120
CG_UPSTREAM_MAX_RETRIES=2        # 0..5,禁止无限重试
# 上游请求是否经环境/系统代理(HTTP_PROXY、ALL_PROXY、Windows 注册表代理)。
# 默认 0(直连)。为什么默认关闭:
#   1. 代理能读到上游 Authorization 头与完整响应体,等于把密钥交给第三方;
#   2. 经代理的连接超时不由我们控制(实测 Windows 上 0.4s 的连接超时被放大到 2.6s),
#      会让「有限重试 + 快速失败」的保证失效;
#   3. 出网路径应当是显式的部署决策,而不是被环境变量悄悄改变。
# 若你的网络确实必须走代理,请显式设为 1,并确认该代理可信。
CG_UPSTREAM_TRUST_ENV=0

# --------------------------------------------------------------------------- #
# 保护策略
# --------------------------------------------------------------------------- #
CG_POLICY_VERSION=cg-policy/1
CG_PROTECTION_MODE=placeholder   # placeholder(脱敏A) | token(令牌化B) | encrypt(加密C)
CG_RESTORE_MODE=categories       # off | confirm | categories | auto(客户端只能收紧)
CG_RESTORE_CATEGORIES=EMAIL,IP,URL,ORG
CG_BLOCK_ON=critical             # none | high | critical:达到该风险且建议阻断 → 拒绝转发
CG_STABLE_TOKENS=0               # 1 = 模式 B 下同值复用同一令牌(便于共指,代价是等值泄漏)
CG_VAULT_TTL_S=3600              # 映射保留时长(秒)
CG_VAULT_MAX_REQUESTS=4096       # 同时保留映射的请求数上限
CG_DETECTION_CONFIG=             # 自定义检测规则 JSON 的路径(见 docs)
CG_RESPONSE_SCAN=audit           # audit(响应侧只统计不回写) | off
CG_STREAM_BUFFER_CHARS=64        # 跨块检测窗口(字符):决定计数滞后上限与内存占用

# 高风险数据的人工确认(受控释放)。高风险值默认**扣留**在模型输出里,只有经过
# 认证的客户端申请 + 管理员审批 + 一次性凭据,才会释放明文(见 docs/ACCEPTANCE.md)。
# 硬性约束:CG_CONFIRM_TTL_S ≤ CG_VAULT_TTL_S —— 若确认比映射活得久,审批通过时
# 映射已过期,会出现「授权了却拿不到」的不一致,启动期会就此告警。
CG_CONFIRM_TTL_S=900             # 确认凭据有效期(秒),必须为正整数
CG_CONFIRM_MAX_RECORDS=2048      # 进程内确认记录上限(LRU 淘汰最旧的终态记录)

# --------------------------------------------------------------------------- #
# 访问控制与限额
# --------------------------------------------------------------------------- #
CG_RATE_LIMIT_PER_MIN=60
CG_MAX_CONCURRENCY=16
CG_MAX_REQUEST_BYTES=1048576
CG_AUDIT_RETENTION_DAYS=30
CG_BOOTSTRAP_CLIENT_NAME=bootstrap
CG_BOOTSTRAP_KEY_FILE=           # 开发环境首个客户端密钥写到此文件(勿提交该文件)
# 注意:引导密钥只在「客户端表为空」时生成一次。若 data/clients/ 已有记录
# (例如之前跑过、或从别处拷贝了数据目录),启动时不会重新签发,明文密钥也无从找回
# —— 此时请用 POST /admin/clients 显式签发新密钥,或撤销旧记录后再启动。
