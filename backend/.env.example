# CryptoGuard 安全中转网关 —— 配置示例（复制为 backend/.env 后按需修改）
#
# 规则:
#   1. 本文件只放示例/空值;真实密钥一律写入 .env(.env 已被 .gitignore 忽略);
#   2. 上游密钥只从环境变量读取，不与客户端密钥混用;
#   3. 生产环境(CG_ENV=production)启动期强制校验:必须设 CG_ADMIN_TOKEN、
#      禁止 CG_ALLOW_ANONYMOUS=1、禁止示例密钥、禁止 CORS 通配，否则拒绝启动;
#   4. 本网关是**单进程**服务：确认/金库/限流/审计均为进程内状态。
#      同一 data/ 目录只允许一个实例，不支持多 worker / 多副本。

# --------------------------------------------------------------------------- #
# 信任根（一旦丢失，审计与客户端密钥摘要都不再可校验）
# --------------------------------------------------------------------------- #
# 64 位十六进制；用于 HKDF 派生各用途域子密钥。生成:
#   python -c "import secrets;print(secrets.token_hex(32))"
VAULT_KEY=

# --------------------------------------------------------------------------- #
# 基础
# --------------------------------------------------------------------------- #
CG_ENV=development              # development | production
CG_HOST=127.0.0.1
CG_PORT=8100
CG_DATA_DIR=                    # 可选:覆盖 data/ 目录（默认仓库根 data/）
CG_ADMIN_TOKEN=                 # 管理接口全权令牌(≥16 字符);空 = 管理接口 503
CG_ADMIN_READONLY_TOKEN=        # 只读管理员：GET/指标/审计校验可用，写操作 403
CG_ALLOW_ANONYMOUS=0            # 1 = 允许未认证调用(仅本机调试;生产禁止)
CG_INSTANCE_LOCK=1              # 1 = 同 data 目录只允许一个进程（推荐）
CG_CORS_ORIGINS=                # 浏览器 CORS 白名单(逗号分隔);空=不挂 CORS;生产禁 "*"

# --------------------------------------------------------------------------- #
# 上游提供商（JSON 数组）
#
# 每项字段:
#   name/type/base_url/models/display_name  必填(base_url 对 mock 可空)
#   api_key_env       密钥所在的环境变量名（只写变量名，不写密钥）
#   token_limit_field max_tokens(默认)或 max_completion_tokens
#   extra_headers/stream_options  厂商附加要求
#   trust_env         是否让 httpx 走环境/系统代理（默认 false）
#
# 注意: 没有 key_source=llm-config；上游密钥只来自环境变量，改钥需重启。
# --------------------------------------------------------------------------- #
CG_PROVIDERS=[{"name":"deepseek","type":"openai-compatible","base_url":"https://api.deepseek.com","api_key_env":"CG_PROVIDER_DEEPSEEK_KEY","models":["deepseek-chat"],"display_name":"DeepSeek","timeout_connect":10,"timeout_read":120,"max_retries":2,"trust_env":false}]
CG_PROVIDER_DEEPSEEK_KEY=       # 真实上游密钥（勿提交）
CG_DEFAULT_PROVIDER=deepseek
CG_DEFAULT_MODEL=deepseek-chat
CG_MODEL_ALIASES={}
CG_ALLOW_UNKNOWN_MODELS=0       # 1 = 允许未声明模型透传(费用风险)
CG_UPSTREAM_TIMEOUT_CONNECT=10
CG_UPSTREAM_TIMEOUT_READ=120
CG_UPSTREAM_MAX_RETRIES=2       # 0..5，禁止无限重试
CG_UPSTREAM_TRUST_ENV=0         # 默认直连；代理会看到 Authorization 与响应体

# --------------------------------------------------------------------------- #
# 保护策略
# --------------------------------------------------------------------------- #
CG_POLICY_VERSION=cg-policy/1
CG_PROTECTION_MODE=token        # placeholder(脱敏A) | token(令牌化B,默认) | encrypt(加密C)
CG_RESTORE_MODE=categories      # off | confirm | categories | auto(客户端只能收紧)
CG_RESTORE_CATEGORIES=EMAIL,IP,URL,ORG
CG_BLOCK_ON=critical            # none | high | critical
CG_STABLE_TOKENS=0              # 1 = 模式 B 同值同令牌(便于共指,代价是等值泄漏)
CG_VAULT_TTL_S=3600
CG_VAULT_MAX_REQUESTS=4096
CG_DETECTION_CONFIG=            # 自定义检测规则 JSON 路径
CG_RESPONSE_SCAN=audit          # audit(只统计不回写) | off
CG_STREAM_BUFFER_CHARS=128      # 响应侧窗口检测;长度 > window-1 的值不可检出

# --------------------------------------------------------------------------- #
# 内容面策略（不静默放行、不静默丢弃）
# --------------------------------------------------------------------------- #
CG_IMAGE_POLICY=reject          # reject(默认) | pass（pass = 显式接受未保护图片）
CG_DOCUMENT_POLICY=reject       # reject(默认) | pass（协议转换通常无法等价转发文档）
CG_ANTHROPIC_THINKING=strip     # strip(默认:接受但不转发/不返回思考块) | reject
CG_CACHE_CONTROL=strip          # strip(默认:只影响 prompt caching) | reject

# --------------------------------------------------------------------------- #
# 人工确认（高风险数据的受控释放）
# --------------------------------------------------------------------------- #
CG_CONFIRM_TTL_S=900            # 必须 ≤ CG_VAULT_TTL_S
CG_CONFIRM_MAX_RECORDS=2048

# --------------------------------------------------------------------------- #
# 访问控制、限额与观测
# --------------------------------------------------------------------------- #
CG_RATE_LIMIT_PER_MIN=600
CG_MAX_CONCURRENCY=32
CG_MAX_REQUEST_BYTES=8388608    # 8 MiB；代码 Agent 请求体通常大于 1 MiB
CG_SSE_HEARTBEAT_S=15           # 等待上游首 token 时发 `: ping`；0=关闭
CG_IDEMPOTENCY_TTL_S=600        # 仅非流式；幂等缓存 AEAD 封缄在内存
CG_IDEMPOTENCY_MAX=1024
CG_METRICS_PUBLIC=0             # 1 = /metrics 允许匿名(仅受信网络)
CG_AUDIT_RETENTION_DAYS=30
CG_CLIENT_KEY_TTL_DAYS=0        # 新建客户端密钥默认有效期；0=永不过期
CG_BOOTSTRAP_CLIENT_NAME=bootstrap
CG_BOOTSTRAP_KEY_FILE=          # 开发环境首个客户端密钥写到此文件(勿提交)

# 说明: 引导密钥只在「客户端表为空」时生成一次。若 data/clients/ 已有记录，
# 启动时不会重新签发，明文也无从找回；请用 POST /admin/clients 显式签发。
